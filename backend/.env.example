# Copy to .env. Every value is optional.
#
# With none of these set, the app runs on an offline corpus with a lexical
# fallback judge - the full pipeline works and the demo is safe. Each key
# upgrades one stage in place; none of them turns the application on.

# Stage 1: live case law database (free EDU membership - see docs/data-sources.md)
COURTLISTENER_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com

# Stage 2: the real support check, instead of the lexical fallback
ANTHROPIC_API_KEY=

# Stage 2 retrieval: legal-domain embeddings, instead of local hashing
VOYAGE_API_KEY=

# Local store
DATABASE_PATH=data/auditor.db
LOAD_DEMO_CORPUS_ON_START=true
